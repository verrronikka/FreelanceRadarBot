# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...   # замените на токен от @BotFather
# TELEGRAM_PROXY_URL=http://proxy:8080   # раскомментируйте, если нужен прокси для Telegram

# Database
DATABASE_URL=postgresql+asyncpg://fr_user:fr_password@localhost:5432/freelanceradar

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenRouter (LLM)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-3.5-sonnet

# Sources (заполните позже)
SOURCE_A_BASE_URL=
SOURCE_A_TOKEN=

# Config
POLL_INTERVAL_SECONDS=60
LLM_TIMEOUT_SECONDS=8
