# ===== Telegram =====
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...      # токен от @BotFather
# Прокси для api.telegram.org (если Telegram не открывается напрямую).
# Happ / v2rayN по умолчанию: http 10809, socks5 10808. Подобрать: python check_telegram_proxy.py
# TELEGRAM_PROXY_URL=http://127.0.0.1:10809
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808

# ===== Database / Redis (поднимаются через docker compose up -d) =====
DATABASE_URL=postgresql+asyncpg://fr_user:fr_password@127.0.0.1:5432/freelanceradar
REDIS_URL=redis://127.0.0.1:6379/0

# ===== OpenRouter (ИИ-фильтр, необязательно) =====
# Без ключа бот работает на детерминированных фильтрах (бюджет + ключевые слова).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-3.5-sonnet
# Прокси для OpenRouter (только http://). По умолчанию берётся TELEGRAM_PROXY_URL.
# LLM_PROXY_URL=

# ===== Источники =====
# Тестовый источник «Example (демо)»: раз в цикл публикует один фейковый заказ.
DEMO_SOURCE_ENABLED=true
# Разрешённая RSS/Atom-лента реальной площадки (только если её правила разрешают автоматическое чтение)
SOURCE_A_BASE_URL=
SOURCE_A_NAME=Источник A
SOURCE_A_TOKEN=

# Freelancehunt через официальный API: токен на https://freelancehunt.com/my/api2
FREELANCEHUNT_TOKEN=
FREELANCEHUNT_ONLY_MY_SKILLS=false

# ===== Эксплуатация =====
POLL_INTERVAL_SECONDS=60     # не меньше 30
LLM_TIMEOUT_SECONDS=8
JOB_RETENTION_DAYS=30        # текст заказа хранится не дольше 30 дней
